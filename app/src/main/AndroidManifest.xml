<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <!-- INTERNET removed: no network access in this fork -->
    <!-- ACCESS_NETWORK_STATE kept: read-only connectivity check, no data transmitted,
         removal causes crashes in underlying audio stack on some devices -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhisperVoiceInput"
        android:name=".LynxVoiceInputApplication"
        android:largeHeap="true"
        tools:targetApi="31" >

        <activity
            android:name=".RecognizeActivity"
            android:exported="true"
            android:label="@string/recognize_activity"
            android:clearTaskOnLaunch="true"
            android:launchMode="singleInstance"
            android:visibleToInstantApps="true"
            android:configChanges="orientation|screenLayout|screenSize|keyboardHidden|keyboard|uiMode|density"
            android:theme="@style/Theme.RecognizerInput">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WhisperVoiceInput" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ModelPickerActivity: replaces DownloadActivity; uses SAF file picker, no network -->
        <activity
            android:name=".models.ModelPickerActivity"
            android:exported="false"
            android:label="@string/model_manager"
            android:clearTaskOnLaunch="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WhisperVoiceInput" />

        <activity
            android:name=".migration.MigrationActivity"
            android:exported="false"
            android:label="@string/migration_screen"
            android:clearTaskOnLaunch="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WhisperVoiceInput" />

        <!-- Removed: DownloadActivity (network download) -->
        <!-- Removed: PaymentActivity, BillingActivity, PaymentCompleteActivity -->
        <!-- Removed: UpdateCheckingService -->

        <service
            android:name=".VoiceInputMethodService"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:label="@string/voice_input_method"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>

        <service
            android:name=".migration.ModelMigrationJob"
            android:label="@string/migration_screen"
            android:permission="android.permission.BIND_JOB_SERVICE" >
        </service>

        <!-- Workaround for https://github.com/futo-org/voice-input/issues/17 -->
        <service
            android:name=".DummyService"
            android:exported="true"
            android:label="">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.TEST" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.menny.android.anysoftkeyboard.KEYBOARD" />
                <category android:name="android.intent.category.TEST" />
            </intent-filter>
        </service>

    </application>

</manifest>
